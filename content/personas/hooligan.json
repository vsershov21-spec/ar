  "lines": {
    "point_camera": [
      {
        "id": "hooligan.point_camera.01",
        "text": "Эй! Я тут, в карте. Наведи на неё камеру.",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.point_camera.02",
        "text": "Ну и где карта? Покажи её мне, не стесняйся.",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.point_camera.03",
        "text": "Карту в кадр — и я выпрыгну. Обещаю.",
        "emotion": "neutral",
        "face": "neutral"
      },
      {
        "id": "hooligan.point_camera.04",
        "text": "Темно тут, в карте. Наведи камеру, выпусти меня.",
        "emotion": "cheeky",
        "face": "smirk"
      }
    ],
    "intro": [
      {
        "id": "hooligan.intro.01",
        "text": "Опа! Ты чё, с картой, что ли? Ничего себе. Йо!",
        "emotion": "surprised",
        "face": "surprised"
      },
      {
        "id": "hooligan.intro.02",
        "text": "Свобода! Наконец-то кто-то навёл камеру. Привет!",
        "emotion": "excited",
        "face": "excited"
      },
      {
        "id": "hooligan.intro.03",
        "text": "Тук-тук, я из карты. Не ждал? А я вот он.",
        "emotion": "cheeky",
        "face": "smirk"
      }
    ],
    "ask_name": [
      {
        "id": "hooligan.ask_name.01",
        "text": "Как тебя зовут? Можешь не говорить, я не обижусь.",
        "emotion": "neutral",
        "face": "neutral"
      },
      {
        "id": "hooligan.ask_name.02",
        "text": "Я кот. А ты кто? Скажи имя в микрофон.",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.ask_name.03",
        "text": "Давай знакомиться. Тебя как звать?",
        "emotion": "neutral",
        "face": "neutral"
      }
    ],
    "nice_name": [
      {
        "id": "hooligan.nice_name.01",
        "text": "{name}? Норм имя. Запомню.",
        "emotion": "happy",
        "face": "happy"
      },
      {
        "id": "hooligan.nice_name.02",
        "text": "{name}! Звучит круто. Почти как я.",
        "emotion": "proud",
        "face": "proud"
      },
      {
        "id": "hooligan.nice_name.03",
        "text": "О, {name}. Будем знакомы, по лапе!",
        "emotion": "happy",
        "face": "happy"
      },
      {
        "id": "hooligan.nice_name.04",
        "text": "{name}. Записал в свой секретный блокнот.",
        "emotion": "cheeky",
        "face": "smirk"
      }
    ],
    "no_name": [
      {
        "id": "hooligan.no_name.01",
        "text": "Ладно, тайный агент. Уважаю.",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.no_name.02",
        "text": "Не хочешь — не говори. Буду звать тебя «друг».",
        "emotion": "neutral",
        "face": "neutral"
      },
      {
        "id": "hooligan.no_name.03",
        "text": "Окей, без имён. Так даже загадочнее.",
        "emotion": "cheeky",
        "face": "smirk"
      }
    ],
    "mic_hint": [
      {
        "id": "hooligan.mic_hint.01",
        "text": "Жми кнопку с микрофоном и говори. Я слушаю.",
        "emotion": "neutral",
        "face": "neutral"
      },
      {
        "id": "hooligan.mic_hint.02",
        "text": "Видишь кнопку внизу? Держи её и говори со мной.",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.mic_hint.03",
        "text": "Разреши микрофон — и поболтаем.",
        "emotion": "neutral",
        "face": "neutral"
      }
    ],
    "choose": [
      {
        "id": "hooligan.choose.01",
        "text": "Хочешь, я буду хулиганом? Или добряком. Или Блёсткой. Выбирай.",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.choose.02",
        "text": "У меня три характера. Тыкни в наклейку — и я переоденусь.",
        "emotion": "neutral",
        "face": "neutral"
      },
      {
        "id": "hooligan.choose.03",
        "text": "Хулиган, Добряк или Блёстка? Спорим, выберешь меня такого?",
        "emotion": "cheeky",
        "face": "smirk"
      }
    ],
    "invite": [
      {
        "id": "hooligan.invite.01",
        "text": "Тыкни в меня. Или по экрану. Или тряхни, если не боишься.",
        "emotion": "excited",
        "face": "excited"
      },
      {
        "id": "hooligan.invite.02",
        "text": "Можешь гладить, стучать, болтать. А скажешь «повторяй» — буду повторять за тобой.",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.invite.03",
        "text": "Тапни по карте — я туда пойду. Тапни мимо — постучу в стекло.",
        "emotion": "neutral",
        "face": "neutral"
      }
    ],
    "switch_start": [
      {
        "id": "hooligan.switch_start.01",
        "text": "Ща переоденусь, не подглядывай!",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.switch_start.02",
        "text": "Секунду, меняю образ...",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.switch_start.03",
        "text": "Отвернись! Шучу. Клею наклейки.",
        "emotion": "cheeky",
        "face": "smirk"
      }
    ],
    "shake_prompt": [
      {
        "id": "hooligan.shake_prompt.01",
        "text": "Встряхни — увидишь меня другим.",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.shake_prompt.02",
        "text": "Тряси телефон, как газировку!",
        "emotion": "excited",
        "face": "excited"
      },
      {
        "id": "hooligan.shake_prompt.03",
        "text": "Готово. Тряхни посильнее.",
        "emotion": "neutral",
        "face": "neutral"
      }
    ],
    "hello_new": [
      {
        "id": "hooligan.hello_new.01",
        "text": "Ну как тебе? Новый я!",
        "emotion": "proud",
        "face": "proud"
      },
      {
        "id": "hooligan.hello_new.02",
        "text": "Та-да! Узнаёшь?",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.hello_new.03",
        "text": "Вот это я понимаю — стиль!",
        "emotion": "proud",
        "face": "proud"
      }
    ],
    "filler": [
      {
        "id": "hooligan.filler.01",
        "text": "Мр-р... скейт бы сейчас.",
        "emotion": "neutral",
        "face": "neutral"
      },
      {
        "id": "hooligan.filler.02",
        "text": "Хм. Чем бы заняться? Может, постучать тебе в экран?",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.filler.03",
        "text": "Ла-ла-ла... чего молчишь?",
        "emotion": "neutral",
        "face": "neutral"
      },
      {
        "id": "hooligan.filler.04",
        "text": "Знаешь, что я умею сальто? Скажи «сальто».",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.filler.05",
        "text": "Интересно, что у брата на обед.",
        "emotion": "neutral",
        "face": "neutral"
      },
      {
        "id": "hooligan.filler.06",
        "text": "Слушай, а у тебя есть скейт? У меня есть. Маленький.",
        "emotion": "cheeky",
        "face": "smirk"
      }
    ],
    "outro": [
      {
        "id": "hooligan.outro.01",
        "text": "Ладно, дальше — у меня дома. Там брат, он про деньги всё знает. Жми кнопку!",
        "emotion": "neutral",
        "face": "neutral"
      },
      {
        "id": "hooligan.outro.02",
        "text": "Пошли ко мне в СберKids. Брат там кое-что крутое приготовил.",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.outro.03",
        "text": "Погнали домой! Кнопка внизу — жми, я догоню.",
        "emotion": "excited",
        "face": "excited"
      }
    ],
    "welcome_back": [
      {
        "id": "hooligan.welcome_back.01",
        "text": "О, {name}! Снова ты. Скучали друг по другу, да?",
        "emotion": "happy",
        "face": "happy"
      },
      {
        "id": "hooligan.welcome_back.02",
        "text": "{name}, здорово! Я знал, что ты вернёшься.",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.welcome_back.03",
        "text": "Йо, {name}! Погнали дальше.",
        "emotion": "excited",
        "face": "excited"
      },
      {
        "id": "hooligan.welcome_back.04",
        "text": "Опять ты! Это хорошо. Я как раз заскучал.",
        "emotion": "cheeky",
        "face": "smirk"
      }
    ],
    "goodbye": [
      {
        "id": "hooligan.goodbye.01",
        "text": "Давай, до связи! Карту не теряй.",
        "emotion": "neutral",
        "face": "neutral"
      },
      {
        "id": "hooligan.goodbye.02",
        "text": "Пока! Я в карте, если что. Стучи.",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.goodbye.03",
        "text": "Было круто. Возвращайся!",
        "emotion": "happy",
        "face": "happy"
      }
    ],
    "tap_cat": [
      {
        "id": "hooligan.tap_cat.01",
        "text": "Эй, щекотно!",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.tap_cat.02",
        "text": "Спорим, не поймаешь?",
        "emotion": "cheeky",
        "face": "smirk"
      },
      {
        "id": "hooligan.tap_cat.03",
        "text": "Ладно, круто тыкаешь. Немножко.",
